# ============================================
# Backend API (NestJS)
# ============================================
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/virtual_closet?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# Python Workers
# ============================================
PYTHONUNBUFFERED=1
WORKERS_PORT=8000

# ============================================
# Cloud Storage
# ============================================
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=virtual-closet-images

# CloudFront
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# ============================================
# Firebase
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Firebase Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key

# ============================================
# Email Providers
# ============================================
# Gmail API
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:4000/auth/gmail/callback

# Naver API
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ============================================
# External APIs
# ============================================
# Weather API (OpenWeatherMap 등)
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ============================================
# Analytics
# ============================================
SEGMENT_WRITE_KEY=your-segment-write-key
AMPLITUDE_API_KEY=your-amplitude-api-key

# ============================================
# Monitoring
# ============================================
SENTRY_DSN=your-sentry-dsn
