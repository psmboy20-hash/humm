{
  "name": "virtual-closet-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "가상 옷장 관리 및 코디 추천 앱 - 모노레포",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @virtual-closet/database migrate",
    "db:seed": "pnpm --filter @virtual-closet/database seed",
    "api:dev": "pnpm --filter @virtual-closet/api dev",
    "mobile:dev": "pnpm --filter @virtual-closet/mobile dev",
    "workers:dev": "pnpm --filter @virtual-closet/workers dev"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.12.0"
}
